{
  "name": "qlchamcong",
  "version": "1.2.1",
  "description": "Phần mềm Quản lý Chấm công – Ngày phép – dành cho viên chức đơn vị sự nghiệp công lập",
  "main": "electron/main.js",
  "author": "QLChamCong",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/parser.test.js",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "vn.qlchamcong.app",
    "productName": "Quan ly Cham cong - Ngay phep",
    "copyright": "QLChamCong",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "ChamCong-NgayPhep-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Quản lý Chấm công – Ngày phép",
      "uninstallDisplayName": "Quản lý Chấm công – Ngày phép",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CaiDat-ChamCong-NgayPhep-${version}-64bit.${ext}",
      "runAfterFinish": true,
      "menuCategory": false,
      "installerLanguages": [
        "vi_VN"
      ],
      "language": "1066",
      "license": "build/license.txt"
    },
    "portable": {
      "artifactName": "ChamCong-NgayPhep-KhongCanCai-${version}-64bit.${ext}"
    },
    "compression": "maximum",
    "electronLanguages": [
      "vi",
      "en-US"
    ]
  }
}
